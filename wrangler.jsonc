{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nama Worker produksi (custom domain pantaumala.live). Jangan diganti ke "pantaumala".
  "name": "pantau-mala",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth", "/auth/*", "/frontend/session"],
  },
  "vars": {
    "FE_ACCESS_MODE": "client",
    "PANTAU_API_ORIGIN": "https://api.pantaumala.live",
    "PANTAU_CLIENT_SLUG": "pantau-mala",
  },
}
