{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantaumala",
  "main": "worker.ts",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/frontend/session",
      "/report-photos/*",
    ],
  },
  "vars": {
    "FE_ACCESS_MODE": "client",
    "PANTAU_API_ORIGIN": "https://api.pantaumala.live",
    "PANTAU_CLIENT_SLUG": "pantau-mala",
  },
}
